# Copy to `.env` and fill in as needed. NEVER commit `.env`.
# Phase 0 requires NO credentials — leave all secret placeholders EMPTY.

# --- runtime ---
ENVIRONMENT=development           # development | test
APP_NAME=aicryptotrader
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- database ---
DATABASE_URL=sqlite:///./data/trading.db

# --- execution safety (Phase 0: all future modes disabled) ---
LIVE_TRADING=false                # MUST be false; enabling it fails at startup in Phase 0
PAPER_TRADING=false
SHADOW_MODE=false

# --- credential placeholders (KEEP EMPTY; no real keys in the repo) ---
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_AUTH_TOKEN=

# --- market data (Phase 1) ---
# JSON arrays; validated against the Symbol/Timeframe source of truth.
MARKET_SYMBOLS=["BTC/USDT","ETH/USDT"]
MARKET_TIMEFRAMES=["1h","4h"]
MAX_STALENESS_INTERVALS=1
FUTURE_TOLERANCE_SECONDS=2
TICKER_STALENESS_SECONDS=30

# --- backtesting (Phase 7: offline, deterministic, pure-quant; no calibration) ---
BACKTEST_DATASET_NAME=example
BACKTEST_STARTING_EQUITY=10000
BACKTEST_COST_SCENARIO=conservative   # optimistic | base | conservative
BACKTEST_SEED=12345
BACKTEST_HALT_POLICY=end_run          # end_run | reset_next_period
BACKTEST_ENTRY_FILL_RULE=next_open    # next_open (default) | signal_close
BACKTEST_MIN_OPERATIONAL_TRADES=100
BACKTEST_ARTIFACTS_DIR=data/backtests

# --- dashboard (Phase 7: read-only + stop-direction-only controls) ---
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1              # loopback only; never public
DASHBOARD_PORT=8787
# DASHBOARD_AUTH_TOKEN is a credential placeholder above (KEEP EMPTY in the repo)

# --- notifications / telegram (Phase 7: offline fixture first; never trades) ---
TELEGRAM_ENABLED=false
TELEGRAM_TRANSPORT=fixture            # fixture (offline) | http (deferred/off)
TELEGRAM_ALLOW_CONTROLS=false
