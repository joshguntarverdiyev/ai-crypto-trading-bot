# Copy to `.env` and fill in as needed. NEVER commit `.env`.
# Phase 0 requires NO credentials — leave all secret placeholders EMPTY.

# --- runtime ---
ENVIRONMENT=development           # development | test
APP_NAME=aicryptotrader
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL

# --- database ---
DATABASE_URL=sqlite:///./data/trading.db

# --- execution safety (Phase 0: all future modes disabled) ---
LIVE_TRADING=false                # MUST be false; enabling it fails at startup in Phase 0
PAPER_TRADING=false
SHADOW_MODE=false

# --- credential placeholders (KEEP EMPTY; no real keys in the repo) ---
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_AUTH_TOKEN=

# --- market data (Phase 1) ---
# JSON arrays; validated against the Symbol/Timeframe source of truth.
MARKET_SYMBOLS=["BTC/USDT","ETH/USDT"]
MARKET_TIMEFRAMES=["1h","4h"]
MAX_STALENESS_INTERVALS=1
FUTURE_TOLERANCE_SECONDS=2
TICKER_STALENESS_SECONDS=30

# --- backtesting (Phase 7: offline, deterministic, pure-quant; no calibration) ---
BACKTEST_DATASET_NAME=example
BACKTEST_STARTING_EQUITY=10000
BACKTEST_COST_SCENARIO=conservative   # optimistic | base | conservative
BACKTEST_SEED=12345
BACKTEST_HALT_POLICY=end_run          # end_run | reset_next_period
BACKTEST_ENTRY_FILL_RULE=next_open    # next_open (default) | signal_close
BACKTEST_MIN_OPERATIONAL_TRADES=100
BACKTEST_ARTIFACTS_DIR=data/backtests

# --- dashboard (Phase 7: read-only + stop-direction-only controls) ---
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1              # loopback only; never public
DASHBOARD_PORT=8787
# DASHBOARD_AUTH_TOKEN is a credential placeholder above (KEEP EMPTY in the repo)

# --- notifications / telegram (Phase 7: offline fixture first; never trades) ---
TELEGRAM_ENABLED=false
TELEGRAM_TRANSPORT=fixture            # fixture (offline) | http (deferred/off)
TELEGRAM_ALLOW_CONTROLS=false

# --- shadow mode (Phase 8: real-time decision pipeline, ZERO execution) ---
# Sources default to the offline `fixture` provider (no network, no credentials).
# Real sources are OFF by default; enabling them NEVER enables trading and NEVER
# requires a trading key (market data uses public/keyless endpoints).
SHADOW_MODE=false                     # already declared above; shadow runs only when true
MARKET_DATA_SOURCE=fixture            # fixture (offline) | ccxt (real, public/keyless)
MARKET_DATA_EXCHANGE_ID=              # public data-source id (required iff ccxt); NOT a live venue
NEWS_SOURCE=fixture                   # fixture (offline) | cryptopanic | cryptonewsapi (real HTTP)
AI_PROVIDER=fixture                   # fixture (offline) | anthropic (real SDK; advisory only)
SHADOW_PRIMARY_TIMEFRAME=1h
SHADOW_CONFIRM_TIMEFRAME=4h
SHADOW_STARTING_EQUITY=10000          # HYPOTHETICAL; flat per boundary (NOT a paper portfolio)
SHADOW_WARMUP_BUFFER_CANDLES=100      # added to the indicator warm-up minimum
SHADOW_MAX_CONSECUTIVE_DATA_FAILURES=3
SHADOW_BACKFILL_BOUNDARIES=0          # 0 => process only the latest completed boundary
SHADOW_CLOCK_DRIFT_SECONDS=60

# --- paper validation (Phase 9: evolving paper account; NO real trading) ---
# Dedicated fail-closed enable flag. P9 runs ONLY when true AND LIVE_TRADING and
# PAPER_TRADING remain false (enforced at startup). This flag never enables or
# mutates live/paper execution. Data/news/AI sources reuse the shared selectors
# above (MARKET_DATA_SOURCE / NEWS_SOURCE / AI_PROVIDER / MARKET_DATA_EXCHANGE_ID);
# each run gets its own isolated SQLite database file under PAPER_RUNS_DIR.
PAPER_VALIDATION_ENABLED=false
PAPER_RUNS_DIR=data/paper_runs        # per-run database files live here (D-ISO)
PAPER_PRIMARY_TIMEFRAME=1h
PAPER_CONFIRM_TIMEFRAME=4h
PAPER_WARMUP_BUFFER_CANDLES=100
PAPER_MAX_CONSECUTIVE_DATA_FAILURES=3
PAPER_CLOCK_DRIFT_SECONDS=60
PAPER_NEWS_SETTLE_SECONDS=120         # conservative availability margin (anti-leakage)
PAPER_OWNER_STALE_INTERVALS=3         # heartbeat staleness (boundaries) before takeover
# Validation gate thresholds (objective; pre-registered per run).
PAPER_MIN_OPERATIONAL_DAYS=90
PAPER_MIN_UPTIME_FRACTION=0.98
PAPER_MAX_UNEXPLAINED_GAPS=24
PAPER_MIN_MEANINGFUL_TRADES=100        # statistical-evidence bar (NOT lowered for 10-day)
PAPER_MIN_TRADES_PER_REGIME_CELL=15
PAPER_SEED=12345
# PAPER_STARTING_EQUITY reuses the Phase 6 paper engine seed (default 10000).

# --- Phase 9 redesign: multi-symbol universe + 10-day window + Claude budget ---
# Defaults preserve the legacy 2-symbol / 90-day behavior; set these for the redesign.
PAPER_VALIDATION_DAYS=90               # set 10 for the redesigned validation window
PAPER_UNIVERSE_ENABLED=false          # true → select a universe from a T0 snapshot
PAPER_UNIVERSE_QUOTE=USDT
PAPER_UNIVERSE_MAX_SYMBOLS=30          # N_max (effective = min(N_max, eligible survivors))
PAPER_UNIVERSE_MIN_QUOTE_VOLUME=5000000   # 24h quote-volume floor (USDT)
PAPER_UNIVERSE_EXCHANGE_ID=binance     # public/keyless market enumeration source
PAPER_CLAUDE_MAX_PER_BOUNDARY=8        # runaway backstop; budget exhaustion → fail-closed HOLD
PAPER_CLAUDE_MAX_PER_RUN=5000
# Degraded trial news cadence for a 10-day window (<=80 calls @ 3h): set in your .env
# CRYPTO_NEWS_POLL_SECONDS=10800       # 3h (trial-budget-safe; see docs/phase-9.md)

# --- Crypto News API news provider (Phase 9; Tier-2 continuous ingestion) ---
# Selected via NEWS_SOURCE=cryptonewsapi. A DEDICATED secret (NOT the dashboard,
# Anthropic, or exchange key). KEEP EMPTY in the repo; supply only in your local
# git-ignored .env. Never logged, committed, or placed in provenance.
CRYPTO_NEWS_API_TOKEN=
CRYPTO_NEWS_BASE_URL=https://cryptonews-api.com/api/v1
# Approved P9 paid-plan values (trial constraints retired). One global request per
# poll passes the universe's base assets as tickers (derived from MARKET_SYMBOLS).
CRYPTO_NEWS_ITEMS=50                   # articles per request (paid max 100; 50 = strong coverage)
CRYPTO_NEWS_MAX_PAGES=1                # pagination cap per poll
CRYPTO_NEWS_POLL_SECONDS=600          # continuous ingestion interval (10 min)
CRYPTO_NEWS_LOOKBACK_HOURS=24         # decision-time store read window
NEWS_INGEST_DB_PATH=data/news_ingest.db  # isolated ingestion store (global; first_seen_at)
# News tickers + NEWS_KNOWN_ASSETS are derived from MARKET_SYMBOLS bases (dynamic;
# set MARKET_SYMBOLS to the P9 universe so alt-coin news is fetched and recognized).
