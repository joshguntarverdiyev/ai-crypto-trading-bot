# --- secrets / credentials (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.secret
secrets/
credentials/

# --- local databases / data ---
*.db
*.sqlite
*.sqlite3
data/*
!data/.gitkeep

# --- logs ---
logs/*
!logs/.gitkeep
*.log

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- virtual environments ---
.venv/
.venv.*/
venv/
env/

# --- IDE / OS ---
.idea/
.vscode/
*.swp
.DS_Store
